"UnLitTwoTexture"
{
    "$basetexture"    "zhattan/fire_gradient_fade"
    "$texture2"    "hacksaw_event/fire_scrolling"
    "$additive" "1"
      $selfillum 1
"$translucent" 1
    "$nocull" "1"
    "%keywords" "tf"
    "Proxies"
    {
        "TextureScroll"
        {
            "texturescrollvar" "$texture2transform"
            "texturescrollrate" .07
            "texturescrollangle" 90
        }
    }
}
